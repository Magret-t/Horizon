  "digest": {
    "max_items": null,
    "profile_order": [
      "research",
      "medicine",
      "tech-news",
      "ai-skills",
      "business",
      "video",
      "learning",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
