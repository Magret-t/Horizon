{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "research": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "medicine": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "business": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "ai-skills": {
        "threshold": 5.5,
        "topic_dedup": true
      },
      "video": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "learning": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
